# =====================================================================
# SOS Car FRONTEND - modelo de configuracao (sem segredos)
#
# Copie para ".env":   cp .env.example .env   (Windows: copy .env.example .env)
# Aqui entram SOMENTE valores publicos: tudo que esta no frontend pode ser
# lido por qualquer pessoa. NUNCA coloque senhas, chaves, Client Secret,
# dados do banco ou SMTP neste projeto (eles ficam no SOSCAR-BACKEND).
# =====================================================================

# Endereco do backend (SOSCAR-BACKEND), sem barra no final.
# Desenvolvimento (o backend sobe em HTTPS por padrao):
API_URL=https://localhost:3000
# Producao, por exemplo:
#API_URL=https://api.exemplo.com

# --- Servidor de desenvolvimento (npm run dev / npm run preview) ---
#PORT=5173
#HOST=0.0.0.0
# HTTPS local opcional (os dois juntos) - necessario para testar o GPS
# pelo celular na rede local (o navegador so libera localizacao em HTTPS).
#TLS_CERT_FILE=
#TLS_KEY_FILE=

# 1 = a Content-Security-Policy passa a BLOQUEAR (padrao: so avisa no console F12).
#CSP_ENFORCAR=1
